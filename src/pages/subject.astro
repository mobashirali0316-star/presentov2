---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Subject Details | Presento">
  <div class="space-y-6 flex-grow flex flex-col justify-start animate-in fade-in duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
    
    <!-- Back & Header Row -->
    <div class="flex flex-col gap-2">
      <a href="/dashboard" class="inline-flex items-center gap-1 text-[9px] font-bold text-muted-text hover:text-ink no-underline uppercase tracking-wider">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        Back to Dashboard
      </a>
      
      <div class="flex justify-between items-start mt-2">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 id="subject-title" class="text-xl font-extrabold text-ink leading-tight">Subject</h1>
            <span id="subject-code-badge" class="hidden px-2 py-0.5 text-[8px] font-bold tracking-wider bg-hairline rounded text-muted-text uppercase">CODE</span>
            <span id="subject-type-badge" class="px-2 py-0.5 text-[8px] font-bold tracking-wider rounded uppercase bg-blue-50 dark:bg-blue-950/20 text-blue-700 dark:text-blue-400">THEORY</span>
          </div>
          <p class="text-[10px] text-muted-text uppercase tracking-wider font-semibold mt-1">
            Course metrics and ledger history
          </p>
        </div>

        <button
          id="btn-delete-course"
          class="h-8 inline-flex items-center justify-center gap-1 px-3.5 rounded-full border border-error-state bg-canvas text-error-state text-xs font-bold hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-all duration-300 active:scale-95 cursor-pointer"
        >
          Delete Course
        </button>
      </div>
    </div>

    <!-- Stats Bento Cards -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bezel-container">
        <div class="bezel-inner text-center py-4">
          <span class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Attendance Rate</span>
          <span id="sub-percentage" class="text-2xl font-extrabold text-ink mt-2 block">0%</span>
        </div>
      </div>

      <div class="bezel-container">
        <div class="bezel-inner text-center py-4">
          <span class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Conducted / Attended</span>
          <span id="sub-ratio" class="text-2xl font-extrabold text-ink mt-2 block">0 / 0</span>
        </div>
      </div>

      <div class="bezel-container">
        <div class="bezel-inner text-center py-4">
          <span class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Cancelled Lectures</span>
          <span id="sub-cancelled" class="text-2xl font-extrabold text-ink mt-2 block">0</span>
        </div>
      </div>

      <div class="bezel-container">
        <div class="bezel-inner text-center py-4 flex flex-col justify-center">
          <span id="bunk-calculator-title" class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Allowance</span>
          <span id="bunk-calculator-badge" class="text-2xl font-extrabold text-ink mt-2 block">0</span>
        </div>
      </div>
    </div>

    <!-- History ledger logs -->
    <div class="bezel-container w-full flex-grow flex flex-col">
      <div class="bezel-inner flex-grow flex flex-col justify-start">
        <h3 class="font-display text-sm font-bold text-ink mb-4">Historical Logs Ledger</h3>
        
        <div id="logs-list-container" class="space-y-2.5 max-h-[350px] overflow-y-auto pr-1 flex-grow">
          <!-- Populated dynamically -->
        </div>
      </div>
    </div>

  </div>

  <script>
    const store = {
      get() {
        const raw = localStorage.getItem("presento-attendance-store");
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            return parsed.state || { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
          } catch (e) {
            console.error(e);
          }
        }
        return { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
      },
      save(state: any) {
        localStorage.setItem("presento-attendance-store", JSON.stringify({ state, version: 0 }));
      }
    };

    let state = store.get();

    if (!state.semester || !state.semester.initialized) {
      window.location.href = (window as any).route ? (window as any).route("/onboarding") : "/onboarding";
    }

    const params = new URLSearchParams(window.location.search);
    const subjectId = params.get("id");

    const subject = state.subjects.find((s: any) => s.id === subjectId);
    if (!subject) {
      window.location.href = (window as any).route ? (window as any).route("/dashboard") : "/dashboard";
    }

    // DOM references
    const subTitle = document.getElementById("subject-title");
    const subCode = document.getElementById("subject-code-badge");
    const subType = document.getElementById("subject-type-badge");
    
    const subPercentage = document.getElementById("sub-percentage");
    const subRatio = document.getElementById("sub-ratio");
    const subCancelled = document.getElementById("sub-cancelled");
    
    const bunkCalcTitle = document.getElementById("bunk-calculator-title");
    const bunkCalcBadge = document.getElementById("bunk-calculator-badge");
    
    const logsListContainer = document.getElementById("logs-list-container");
    const deleteBtn = document.getElementById("btn-delete-course");

    // Formulas
    const calculateSafeBunks = (present: number, total: number, targetPct: number) => {
      if (total === 0) return 0;
      const R = targetPct / 100;
      if (present / total < R) return 0;
      return Math.floor((present - R * total) / R);
    };

    const calculateRequiredAttendance = (present: number, total: number, targetPct: number) => {
      const R = targetPct / 100;
      if (total === 0 || (present / total) >= R) return 0;
      if (R >= 1.0) return Infinity;
      return Math.ceil((R * total - present) / (1 - R));
    };

    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, "0");
    const day = String(today.getDate()).padStart(2, "0");
    const todayStr = `${year}-${month}-${day}`;

    // Dynamic Occurred Slots Evaluator - auto-marks THEORY only
    const getOccurredList = () => {
      const occurred = [];
      const start = new Date(state.semester.startDate);
      const end = new Date(today);
      
      start.setHours(0, 0, 0, 0);
      end.setHours(0, 0, 0, 0);
      
      if (isNaN(start.getTime())) return [];

      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const ist = new Date(utc + (3600000 * 5.5));
      const isPast5PM = ist.getHours() >= 17;

      const oneDay = 24 * 60 * 60 * 1000;
      const daysDiff = Math.floor((end.getTime() - start.getTime()) / oneDay);

      for (let i = 0; i <= daysDiff; i++) {
        const current = new Date(start.getTime() + i * oneDay);
        const cy = current.getFullYear();
        const cm = String(current.getMonth() + 1).padStart(2, "0");
        const cd = String(current.getDate()).padStart(2, "0");
        const dateStr = `${cy}-${cm}-${cd}`;

        if (dateStr > todayStr) continue;
        if (state.holidays.some((h: any) => h.date === dateStr)) continue;

        const weekday = current.getDay();
        if (weekday === 0) continue; // Sunday

        const daySlots = state.timetable.filter((t: any) => t.dayOfWeek === weekday);
        
        daySlots.forEach((slot: any) => {
          const log = state.attendanceLogs.find(
            (l: any) => l.date === dateStr && l.slotId === slot.id
          );

          if (log) {
            occurred.push({
              date: dateStr,
              slotId: slot.id,
              subjectId: slot.subjectId,
              status: log.status
            });
          } else {
            // Auto-marks THEORY only
            const subject = state.subjects.find((s: any) => s.id === slot.subjectId);
            const isTheory = subject?.type === "THEORY";
            
            if (isTheory) {
              if (dateStr < todayStr) {
                occurred.push({
                  date: dateStr,
                  slotId: slot.id,
                  subjectId: slot.subjectId,
                  status: "PRESENT"
                });
              } else if (dateStr === todayStr && isPast5PM) {
                occurred.push({
                  date: dateStr,
                  slotId: slot.id,
                  subjectId: slot.subjectId,
                  status: "PRESENT"
                });
              }
            }
          }
        });
      }

      state.attendanceLogs.forEach((log: any) => {
        const isSlotCaptured = occurred.some(
          (o) => o.date === log.date && o.slotId === log.slotId
        );
        if (!isSlotCaptured && log.date >= state.semester.startDate && log.date <= todayStr) {
          occurred.push({
            date: log.date,
            slotId: log.slotId || null,
            subjectId: log.subjectId,
            status: log.status
          });
        }
      });

      return occurred;
    };

    const renderSubjectDetails = () => {
      state = store.get();
      
      const sub = state.subjects.find((s: any) => s.id === subjectId);
      if (!sub) return;

      if (subTitle) subTitle.textContent = sub.name;
      if (subCode) {
        if (sub.code) {
          subCode.textContent = sub.code;
          subCode.classList.remove("hidden");
        } else {
          subCode.classList.add("hidden");
        }
      }
      if (subType) {
        subType.textContent = sub.type === "THEORY" ? "Theory" : "Lab";
      }

      // Read from evaluated occurredList
      const occurredList = getOccurredList();
      const logs = occurredList
        .filter((l: any) => l.subjectId === subjectId)
        .sort((a: any, b: any) => b.date.localeCompare(a.date) || b.slotId.localeCompare(a.slotId));

      const present = logs.filter((l: any) => l.status === "PRESENT").length;
      const absent = logs.filter((l: any) => l.status === "ABSENT").length;
      const cancelled = logs.filter((l: any) => l.status === "CANCELLED").length;
      const total = present + absent;

      const target = sub.targetPct || state.semester.targetPct;
      const pct = total === 0 ? 0 : parseFloat(((present / total) * 100).toFixed(1)); // Defaults to 0% if total is 0
      
      if (subPercentage) subPercentage.textContent = `${pct}%`;
      if (subRatio) subRatio.textContent = `${present} / ${total}`;
      if (subCancelled) subCancelled.textContent = cancelled.toString();

      if (bunkCalcTitle && bunkCalcBadge) {
        bunkCalcBadge.classList.remove("text-success-state", "text-error-state");
        if (pct >= target) {
          const safe = calculateSafeBunks(present, total, target);
          bunkCalcTitle.textContent = "Safe Bunks Left";
          bunkCalcBadge.textContent = safe.toString();
          bunkCalcBadge.classList.add("text-success-state");
        } else {
          const req = calculateRequiredAttendance(present, total, target);
          bunkCalcTitle.textContent = "Required Lectures";
          bunkCalcBadge.textContent = req === Infinity ? "∞" : req.toString();
          bunkCalcBadge.classList.add("text-error-state");
        }
      }

      if (logsListContainer) {
        logsListContainer.innerHTML = "";

        if (logs.length === 0) {
          logsListContainer.innerHTML = `
            <div class="flex-grow flex flex-col items-center justify-center text-center p-6 border border-dashed border-hairline rounded-xl bg-surface-soft/40">
              <p class="text-xs text-muted-text font-bold uppercase tracking-wider mb-0.5">No logged history</p>
              <p class="text-[10px] text-muted-soft">Mark attendance in the dashboard or calendar.</p>
            </div>
          `;
          return;
        }

        logs.forEach((log: any) => {
          const slot = state.timetable.find((t: any) => t.id === log.slotId);
          const orderText = slot ? `Lecture ${slot.sequenceOrder + 1}` : "One-time override";
          
          let colorClass = "bg-emerald-500/10 text-emerald-500 border-emerald-100 dark:border-emerald-900/30";
          if (log.status === "ABSENT") colorClass = "bg-rose-500/10 text-rose-500 border-rose-100 dark:border-rose-900/30";
          else if (log.status === "CANCELLED") colorClass = "bg-amber-500/10 text-amber-500 border-amber-100 dark:border-amber-900/30";

          const item = document.createElement("div");
          item.className = "flex items-center justify-between p-3 border border-hairline rounded-xl bg-surface-soft/40 hover:border-muted-soft transition-all duration-300";
          item.innerHTML = `
            <div>
              <span class="font-bold text-xs text-ink block">${log.date}</span>
              <span class="text-[8px] uppercase tracking-wider text-muted-soft font-bold">${orderText}</span>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 border rounded-full ${colorClass}">
                ${log.status}
              </span>
              <button class="btn-toggle-log-status border border-hairline hover:bg-surface-soft text-ink font-bold text-[9px] uppercase px-2.5 py-1.5 rounded-full transition-all active:scale-95 cursor-pointer" data-date="${log.date}" data-slot-id="${log.slotId || ""}" data-status="${log.status}">
                Toggle
              </button>
            </div>
          `;
          logsListContainer.appendChild(item);
        });

        document.querySelectorAll(".btn-toggle-log-status").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const logDate = target.getAttribute("data-date") || "";
            const slotId = target.getAttribute("data-slot-id") || null;
            const currentStatus = target.getAttribute("data-status") || "";
            
            let nextStatus = "PRESENT";
            if (currentStatus === "PRESENT") nextStatus = "ABSENT";
            else if (currentStatus === "ABSENT") nextStatus = "CANCELLED";

            const logIdx = state.attendanceLogs.findIndex(
              (l: any) => l.date === logDate && l.slotId === (slotId || null)
            );

            if (logIdx >= 0) {
              state.attendanceLogs[logIdx].status = nextStatus;
              state.attendanceLogs[logIdx].updatedAt = new Date().toISOString();
            } else {
              state.attendanceLogs.push({
                id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
                subjectId,
                slotId: slotId || null,
                date: logDate,
                status: nextStatus,
                updatedAt: new Date().toISOString()
              });
            }

            store.save(state);
            renderSubjectDetails();
          });
        });
      }
    };

    deleteBtn?.addEventListener("click", () => {
      if (confirm("Are you sure you want to delete this course and all its attendance history? This cannot be undone.")) {
        state.subjects = state.subjects.filter((s: any) => s.id !== subjectId);
        state.timetable = state.timetable.filter((t: any) => t.subjectId !== subjectId);
        state.attendanceLogs = state.attendanceLogs.filter((l: any) => l.subjectId !== subjectId);
        
        store.save(state);
        window.location.href = (window as any).route ? (window as any).route("/dashboard") : "/dashboard";
      }
    });

    renderSubjectDetails();
  </script>
</Layout>
