---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Settings | Presento">
  <div class="space-y-6 flex-grow flex flex-col justify-start animate-in fade-in duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
    
    <!-- Header -->
    <div>
      <h1 class="text-xl font-extrabold tracking-tight text-ink">
        Settings Console<span class="text-brand-accent">.</span>
      </h1>
      <p class="text-[10px] text-muted-text uppercase tracking-wider font-semibold mt-0.5">
        Adjust configurations, courses, and timetable slots
      </p>
    </div>

    <!-- Feedback Message -->
    <div id="settings-message-box" class="p-3 border rounded-xl text-xs font-bold hidden animate-in fade-in duration-300">
      <!-- Status response text -->
    </div>

    <!-- Section 1: Semester Settings -->
    <div class="bezel-container w-full">
      <div class="bezel-inner space-y-4">
        <h2 class="font-display text-xs font-extrabold text-ink uppercase tracking-wider">Semester Configurations</h2>
        
        <form id="settings-form" class="space-y-4">
          <div>
            <label class="block text-[9px] font-bold text-ink mb-1.5 uppercase tracking-wider">Your Name</label>
            <input
              type="text"
              id="settings-student-name"
              class="w-full h-10 px-3 py-2 border border-hairline rounded-lg bg-canvas text-ink text-sm outline-none focus:border-ink font-semibold"
            />
          </div>

          <div>
            <label class="block text-[9px] font-bold text-ink mb-1.5 uppercase tracking-wider">Semester Start Date</label>
            <input
              type="date"
              id="settings-sem-start"
              class="w-full h-10 px-3 py-2 border border-hairline rounded-lg bg-canvas text-ink text-sm outline-none focus:border-ink font-semibold"
            />
          </div>

          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="block text-[9px] font-bold text-ink uppercase tracking-wider">Required Theory Attendance Target</label>
              <span id="settings-target-pct-label" class="font-display font-bold text-brand-accent text-xs">75%</span>
            </div>
            <input
              type="range"
              id="settings-sem-target"
              min="50"
              max="100"
              class="w-full accent-primary h-1.5 bg-hairline rounded-lg appearance-none cursor-pointer"
            />
          </div>

          <div class="flex justify-end pt-4 border-t border-hairline">
            <button
              type="submit"
              class="h-9 px-5 rounded-full bg-primary hover:bg-primary-active text-canvas text-xs font-bold transition-all duration-300 active:scale-95 cursor-pointer flex items-center gap-1.5"
            >
              Save Configurations
            </button>
          </div>
        </form>

      </div>
    </div>

    <!-- Section 2: Manage Courses -->
    <div class="bezel-container w-full">
      <div class="bezel-inner space-y-4">
        <h2 class="font-display text-xs font-extrabold text-ink uppercase tracking-wider">Manage Courses</h2>
        
        <!-- Add Subject Inline Form -->
        <div class="space-y-3 p-3 border border-hairline rounded-xl bg-surface-soft/20">
          <span class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Add New Course</span>
          <div class="grid grid-cols-1 gap-2.5">
            <input
              type="text"
              id="settings-sub-name"
              class="w-full h-9 px-3 py-1.5 border border-hairline rounded-lg bg-canvas text-ink text-xs outline-none focus:border-ink"
              placeholder="e.g. Database Systems"
            />
            <div class="grid grid-cols-2 gap-2">
              <input
                type="text"
                id="settings-sub-code"
                class="h-9 px-3 py-1.5 border border-hairline rounded-lg bg-canvas text-ink text-xs outline-none focus:border-ink"
                placeholder="Code (Optional)"
              />
              <select
                id="settings-sub-type"
                class="h-9 px-3 py-1.5 border border-hairline rounded-lg bg-canvas text-ink text-xs outline-none focus:border-ink font-semibold"
              >
                <option value="THEORY">Theory Class</option>
                <option value="PRACTICAL">Practical Lab</option>
              </select>
            </div>
            <button
              id="btn-settings-add-sub"
              class="w-full h-8 rounded-full bg-primary hover:bg-primary-active text-canvas text-xs font-bold transition-all active:scale-95 cursor-pointer"
            >
              Add Course
            </button>
          </div>
        </div>

        <!-- Subjects List -->
        <div class="space-y-2">
          <span class="text-[8px] font-bold text-muted-text uppercase tracking-wider block">Current Courses</span>
          <div id="settings-subject-list" class="space-y-2 max-h-[200px] overflow-y-auto pr-1">
            <!-- Populated dynamically -->
          </div>
        </div>

      </div>
    </div>

    <!-- Section 3: Manage Timetable Schedule -->
    <div class="bezel-container w-full">
      <div class="bezel-inner space-y-4">
        <h2 class="font-display text-xs font-extrabold text-ink uppercase tracking-wider">Edit Timetable Schedule</h2>
        
        <!-- Day tabs select -->
        <div class="flex border-b border-hairline overflow-x-auto gap-1 pb-1">
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-primary bg-primary text-on-primary whitespace-nowrap cursor-pointer" data-day="1">Mon</button>
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-transparent text-muted-text hover:text-ink hover:bg-surface-soft whitespace-nowrap cursor-pointer" data-day="2">Tue</button>
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-transparent text-muted-text hover:text-ink hover:bg-surface-soft whitespace-nowrap cursor-pointer" data-day="3">Wed</button>
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-transparent text-muted-text hover:text-ink hover:bg-surface-soft whitespace-nowrap cursor-pointer" data-day="4">Thu</button>
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-transparent text-muted-text hover:text-ink hover:bg-surface-soft whitespace-nowrap cursor-pointer" data-day="5">Fri</button>
          <button class="settings-day-tab px-3 py-1.5 text-xs font-bold rounded-md border border-transparent text-muted-text hover:text-ink hover:bg-surface-soft whitespace-nowrap cursor-pointer" data-day="6">Sat</button>
        </div>

        <!-- Add Slot Row -->
        <div class="flex gap-2">
          <select
            id="settings-timetable-sub-select"
            class="flex-grow h-9 px-3 py-1.5 border border-hairline rounded-lg bg-canvas text-ink text-xs outline-none focus:border-ink font-semibold"
          >
            <!-- Populated dynamically -->
          </select>
          <button
            id="btn-settings-add-slot"
            class="h-9 px-4 rounded-full bg-primary hover:bg-primary-active text-canvas text-xs font-bold transition-all duration-300 active:scale-95 cursor-pointer shrink-0"
          >
            Add Lecture
          </button>
        </div>

        <!-- Active Timetable checklist -->
        <div class="space-y-2">
          <h3 class="font-display text-xs font-bold text-ink uppercase tracking-wider" id="settings-timetable-title">Monday Lectures</h3>
          <div id="settings-timetable-list" class="space-y-2 max-h-[220px] overflow-y-auto pr-1">
            <!-- Populated dynamically -->
          </div>
        </div>

      </div>
    </div>

    <!-- Reset database zone -->
    <div class="bezel-container w-full border-error-state/25 bg-rose-50/10 dark:bg-rose-950/5">
      <div class="bezel-inner border-error-state/20 space-y-4">
        <div>
          <h3 class="font-display text-sm font-extrabold text-error-state tracking-tight">Danger Zone</h3>
          <p class="text-[9px] text-muted-soft uppercase tracking-wider font-bold mt-1">
            Resets all configurations, slot schedules, and logged attendance records.
          </p>
        </div>

        <button
          id="btn-purge-data"
          class="h-9 px-4 rounded-full border border-error-state bg-canvas text-error-state text-xs font-bold hover:bg-rose-50 dark:hover:bg-rose-950/20 transition-all duration-300 active:scale-95 cursor-pointer"
        >
          Reset Application Data
        </button>
      </div>
    </div>

  </div>

  <script>
    const store = {
      get() {
        const raw = localStorage.getItem("presento-attendance-store");
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            return parsed.state || { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
          } catch (e) {
            console.error(e);
          }
        }
        return { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
      },
      save(state: any) {
        localStorage.setItem("presento-attendance-store", JSON.stringify({ state, version: 0 }));
      }
    };

    let state = store.get();

    if (!state.semester || !state.semester.initialized) {
      window.location.href = (window as any).route ? (window as any).route("/onboarding") : "/onboarding";
    }

    let currentDayOfWeek = 1;

    // DOM references Semester
    const studentNameInput = document.getElementById("settings-student-name") as HTMLInputElement;
    const semStartInput = document.getElementById("settings-sem-start") as HTMLInputElement;
    const semTargetInput = document.getElementById("settings-sem-target") as HTMLInputElement;
    const targetLabel = document.getElementById("settings-target-pct-label");
    const messageBox = document.getElementById("settings-message-box");
    const form = document.getElementById("settings-form");
    const purgeBtn = document.getElementById("btn-purge-data");

    // DOM references Courses
    const subNameInput = document.getElementById("settings-sub-name") as HTMLInputElement;
    const subCodeInput = document.getElementById("settings-sub-code") as HTMLInputElement;
    const subTypeSelect = document.getElementById("settings-sub-type") as HTMLSelectElement;
    const addSubBtn = document.getElementById("btn-settings-add-sub");
    const subjectListContainer = document.getElementById("settings-subject-list");

    // DOM references Timetable
    const timetableSubSelect = document.getElementById("settings-timetable-sub-select") as HTMLSelectElement;
    const addSlotBtn = document.getElementById("btn-settings-add-slot");
    const timetableTitle = document.getElementById("settings-timetable-title");
    const timetableListContainer = document.getElementById("settings-timetable-list");

    // Prepopulate Semester Form
    if (state.semester) {
      studentNameInput.value = state.semester.studentName || "Student";
      semStartInput.value = state.semester.startDate;
      semTargetInput.value = state.semester.targetPct.toString();
      if (targetLabel) targetLabel.textContent = `${state.semester.targetPct}%`;
    }

    semTargetInput?.addEventListener("input", (e) => {
      if (targetLabel) targetLabel.textContent = `${(e.target as HTMLInputElement).value}%`;
    });

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!messageBox) return;

      messageBox.classList.add("hidden");
      messageBox.classList.remove("bg-emerald-500/10", "border-emerald-200/50", "text-emerald-500", "bg-rose-500/10", "border-rose-200/50", "text-rose-500");

      const studentName = studentNameInput.value || "Student";
      const start = semStartInput.value || "";
      const target = parseInt(semTargetInput.value || "75");

      if (!start) {
        messageBox.textContent = "Please fill in all semester fields.";
        messageBox.classList.add("bg-rose-500/10", "border-rose-200/50", "text-rose-500");
        messageBox.classList.remove("hidden");
        return;
      }

      state.semester = {
        studentName,
        name: "Active Semester",
        startDate: start,
        endDate: "",
        targetPct: target,
        initialized: true,
      };

      store.save(state);

      messageBox.textContent = "Configurations updated successfully!";
      messageBox.classList.add("bg-emerald-500/10", "border-emerald-200/50", "text-emerald-500");
      messageBox.classList.remove("hidden");
    });

    // --- Courses Management ---
    const renderSubjectList = () => {
      if (!subjectListContainer) return;
      subjectListContainer.innerHTML = "";

      if (state.subjects.length === 0) {
        subjectListContainer.innerHTML = `
          <div class="text-center py-4 border border-dashed border-hairline rounded-xl bg-surface-soft/40">
            <p class="text-[10px] text-muted-soft font-bold uppercase">No courses configured</p>
          </div>
        `;
        return;
      }

      state.subjects.forEach((sub: any) => {
        const item = document.createElement("div");
        item.className = "flex items-center justify-between p-2.5 border border-hairline rounded-xl bg-surface-soft/40 hover:border-muted-text transition-all duration-300";
        item.innerHTML = `
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-semibold text-xs text-ink truncate">${sub.name}</span>
              ${sub.code ? `<span class="px-2 py-0.5 text-[8px] font-bold bg-hairline rounded text-muted-text uppercase tracking-wider">${sub.code}</span>` : ""}
              <span class="px-2 py-0.5 text-[8px] font-bold rounded uppercase bg-blue-50 dark:bg-blue-950/20 text-blue-700 dark:text-blue-400 tracking-wider">${sub.type === "THEORY" ? "Theory" : "Lab"}</span>
            </div>
          </div>
          <button class="btn-delete-subject p-1.5 text-muted-text hover:text-error-state transition-colors cursor-pointer" data-id="${sub.id}">
            <svg class="h-4 w-4 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        `;
        subjectListContainer.appendChild(item);
      });

      document.querySelectorAll(".btn-delete-subject").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.getAttribute("data-id");
          if (confirm("Are you sure you want to delete this course and all its timetable entries? This will affect historical statistics.")) {
            state.subjects = state.subjects.filter((sub: any) => sub.id !== id);
            state.timetable = state.timetable.filter((slot: any) => slot.subjectId !== id);
            state.attendanceLogs = state.attendanceLogs.filter((log: any) => log.subjectId !== id);
            store.save(state);
            renderSubjectList();
            populateTimetableSubjectSelect();
            renderTimetableList();
          }
        });
      });
    };

    addSubBtn?.addEventListener("click", () => {
      const name = subNameInput?.value || "";
      const code = subCodeInput?.value || "";
      const type = subTypeSelect?.value || "THEORY";

      if (!name.trim()) return;

      const newSub = {
        id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
        name: name.trim(),
        code: code.trim().toUpperCase() || undefined,
        type,
      };

      state.subjects.push(newSub);
      store.save(state);

      if (subNameInput) subNameInput.value = "";
      if (subCodeInput) subCodeInput.value = "";

      renderSubjectList();
      populateTimetableSubjectSelect();
    });

    // --- Timetable Management ---
    const populateTimetableSubjectSelect = () => {
      if (!timetableSubSelect) return;
      timetableSubSelect.innerHTML = "";
      state.subjects.forEach((sub: any) => {
        const option = document.createElement("option");
        option.value = sub.id;
        option.textContent = `${sub.name} (${sub.type === "THEORY" ? "Theory" : "Lab"})`;
        timetableSubSelect.appendChild(option);
      });
    };

    const renderTimetableList = () => {
      if (!timetableListContainer || !timetableTitle) return;

      const dayNames = ["", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      timetableTitle.textContent = `${dayNames[currentDayOfWeek]} Lectures`;
      timetableListContainer.innerHTML = "";

      const daySlots = state.timetable
        .filter((t: any) => t.dayOfWeek === currentDayOfWeek)
        .sort((a: any, b: any) => a.sequenceOrder - b.sequenceOrder);

      if (daySlots.length === 0) {
        timetableListContainer.innerHTML = `
          <div class="text-center py-6 border border-dashed border-hairline rounded-xl bg-surface-soft/40">
            <p class="text-xs text-muted-text font-bold uppercase mb-0.5">Free day</p>
            <p class="text-[10px] text-muted-soft">No lectures scheduled for this day.</p>
          </div>
        `;
        return;
      }

      daySlots.forEach((slot: any, idx: number) => {
        const subject = state.subjects.find((s: any) => s.id === slot.subjectId);
        const item = document.createElement("div");
        item.className = "flex items-center justify-between p-3 border border-hairline rounded-xl bg-surface-soft/40 hover:border-muted-text transition-all duration-300";
        item.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="h-6 w-6 rounded-full bg-hairline text-ink flex items-center justify-center text-xs font-bold font-display select-none">
              ${idx + 1}
            </div>
            <div>
              <span class="font-semibold text-xs text-ink block">${subject ? subject.name : "Unknown Subject"}</span>
              <span class="text-[8px] uppercase tracking-wider text-muted-text font-bold">${subject?.type === "THEORY" ? "Theory" : "Lab"}</span>
            </div>
          </div>
          <button class="btn-delete-slot p-1 text-muted-text hover:text-error-state transition-colors cursor-pointer" data-id="${slot.id}">
            <svg class="h-3.5 w-3.5 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        `;
        timetableListContainer.appendChild(item);
      });

      document.querySelectorAll(".btn-delete-slot").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.getAttribute("data-id");
          
          state.timetable = state.timetable.filter((slot: any) => slot.id !== id);
          
          // Re-sort sequenceOrder indices
          const remainingSlots = state.timetable
            .filter((t: any) => t.dayOfWeek === currentDayOfWeek)
            .sort((a: any, b: any) => a.sequenceOrder - b.sequenceOrder);
            
          remainingSlots.forEach((slot: any, idx: number) => {
            slot.sequenceOrder = idx;
          });

          store.save(state);
          renderTimetableList();
        });
      });
    };

    addSlotBtn?.addEventListener("click", () => {
      const subId = timetableSubSelect?.value;
      if (!subId) return;

      const currentSlots = state.timetable.filter((t: any) => t.dayOfWeek === currentDayOfWeek);
      const order = currentSlots.length;

      const newSlot = {
        id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
        subjectId: subId,
        dayOfWeek: currentDayOfWeek,
        sequenceOrder: order,
      };

      state.timetable.push(newSlot);
      store.save(state);
      renderTimetableList();
    });

    // Weekday tabs handler
    const tabs = document.querySelectorAll(".settings-day-tab");
    tabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        tabs.forEach((t) => t.classList.remove("border-primary", "bg-primary", "text-on-primary"));
        tabs.forEach((t) => t.classList.add("border-transparent", "text-muted-text"));
        
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.remove("border-transparent", "text-muted-text");
        target.classList.add("border-primary", "bg-primary", "text-on-primary");
        
        currentDayOfWeek = parseInt(target.getAttribute("data-day") || "1");
        renderTimetableList();
      });
    });

    purgeBtn?.addEventListener("click", () => {
      if (confirm("WARNING: This will delete ALL subjects, timetable slots, and attendance logs. This action is permanent. Do you wish to proceed?")) {
        localStorage.removeItem("presento-attendance-store");
        localStorage.removeItem("presento-gemini-key");
        window.location.href = (window as any).route ? (window as any).route("/onboarding") : "/onboarding";
      }
    });

    // Initial render call
    renderSubjectList();
    populateTimetableSubjectSelect();
    renderTimetableList();
  </script>
</Layout>
