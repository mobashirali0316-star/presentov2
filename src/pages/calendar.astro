---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Calendar | Presento">
  <div class="space-y-6 flex-grow flex flex-col justify-start animate-in fade-in duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
    
    <!-- Header with Month Navigator -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold tracking-tight text-ink">
          Calendar<span class="text-brand-accent">.</span>
        </h1>
        <p class="text-[10px] text-muted-text uppercase tracking-wider font-semibold mt-0.5">
          Retroactive Override Logs
        </p>
      </div>

      <!-- Month Selector Dock -->
      <div class="flex items-center gap-1.5 bg-canvas border border-hairline p-1 rounded-full shadow-sm">
        <button id="btn-prev-month" class="h-6 w-6 flex items-center justify-center hover:bg-surface-soft text-ink rounded-full transition-colors cursor-pointer">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <span id="month-year-label" class="text-[9px] font-bold px-1 text-ink select-none w-20 text-center uppercase tracking-wider">
          August 2026
        </span>
        <button id="btn-next-month" class="h-6 w-6 flex items-center justify-center hover:bg-surface-soft text-ink rounded-full transition-colors cursor-pointer">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <!-- Color legends -->
    <div class="bezel-container w-full">
      <div class="bezel-inner flex flex-wrap gap-x-4 gap-y-1.5 justify-center text-[8px] text-muted-text font-bold uppercase tracking-wider">
        <div class="flex items-center gap-1">
          <div class="h-2 w-2 bg-emerald-500 rounded-full"></div>
          <span>Present</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="h-2 w-2 bg-amber-500 rounded-full"></div>
          <span>Partial</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="h-2 w-2 bg-rose-500 rounded-full"></div>
          <span>Absent</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="h-2 w-2 bg-zinc-400 rounded-full"></div>
          <span>Cancelled</span>
        </div>
        <div class="flex items-center gap-1">
          <div class="h-2 w-2 bg-blue-500 rounded-full"></div>
          <span>Holiday</span>
        </div>
      </div>
    </div>

    <!-- Calendar Bezel container -->
    <div class="bezel-container w-full flex-grow flex flex-col">
      <div class="bezel-inner p-0 overflow-hidden flex-grow flex flex-col">
        
        <!-- Weekdays header -->
        <div class="grid grid-cols-6 border-b border-hairline text-center py-2.5 bg-surface-soft/60 text-[9px] font-bold text-muted-text uppercase tracking-wider">
          <div>Mon</div>
          <div>Tue</div>
          <div>Wed</div>
          <div>Thu</div>
          <div>Fri</div>
          <div>Sat</div>
        </div>

        <!-- Grid body cells -->
        <div id="calendar-grid-cells" class="grid grid-cols-6 divide-x divide-y divide-hairline bg-hairline-soft/30 flex-grow">
          <!-- Populated dynamically -->
        </div>

      </div>
    </div>

  </div>

  <!-- Interactive Overrides Modal -->
  <div id="calendar-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-sm bg-canvas border border-hairline rounded-2xl p-5 shadow-2xl relative animate-in fade-in zoom-in-95 duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
      
      <h3 class="font-display text-sm font-extrabold text-ink tracking-tight">
        Override Class Records
      </h3>
      <p class="text-[9px] text-muted-soft uppercase tracking-wider font-bold mb-4">
        Logs override for <span id="modal-date-label" class="text-brand-accent">2026-08-01</span>.
      </p>

      <div class="space-y-4">
        
        <!-- Holiday toggle switch -->
        <div class="flex items-center justify-between p-3 border border-hairline rounded-xl bg-surface-soft/30">
          <div>
            <span class="font-bold text-xs text-ink block">Declare as Holiday</span>
            <span class="text-[8px] text-muted-soft uppercase tracking-wider block mt-0.5">Suspends target checking</span>
          </div>
          <button
            id="btn-modal-holiday-toggle"
            class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border border-transparent transition-colors duration-200 ease-in-out outline-none bg-hairline"
          >
            <span
              id="holiday-toggle-slider"
              class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-canvas shadow transition duration-200 ease-in-out translate-x-0"
            ></span>
          </button>
        </div>

        <!-- Lectures List checklist -->
        <div id="modal-lectures-section" class="space-y-2.5 pt-2 border-t border-hairline">
          <div class="flex justify-between items-center mb-2">
            <span class="text-[9px] font-bold text-muted-text uppercase tracking-wider">Lectures Scheduled</span>
            <div class="flex gap-1.5">
              <button
                id="btn-modal-present-all"
                class="px-2.5 py-1 text-[8px] font-bold border border-hairline rounded-full bg-canvas hover:bg-surface-soft text-emerald-500 transition-colors cursor-pointer"
              >
                Present All
              </button>
              <button
                id="btn-modal-absent-all"
                class="px-2.5 py-1 text-[8px] font-bold border border-hairline rounded-full bg-canvas hover:bg-surface-soft text-rose-500 transition-colors cursor-pointer"
              >
                Absent All
              </button>
            </div>
          </div>
          <div id="modal-lectures-container" class="space-y-2">
            <!-- Populated dynamically -->
          </div>
        </div>

      </div>

      <div class="mt-6 flex justify-end">
        <button
          id="btn-close-modal"
          class="h-9 px-6 rounded-full bg-primary hover:bg-primary-active text-canvas text-xs font-bold transition-all duration-300 active:scale-95 cursor-pointer shadow-sm"
        >
          Done
        </button>
      </div>

    </div>
  </div>

  <script>
    const store = {
      get() {
        const raw = localStorage.getItem("presento-attendance-store");
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            return parsed.state || { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
          } catch (e) {
            console.error(e);
          }
        }
        return { semester: null, subjects: [], timetable: [], attendanceLogs: [], holidays: [] };
      },
      save(state: any) {
        localStorage.setItem("presento-attendance-store", JSON.stringify({ state, version: 0 }));
      }
    };

    let state = store.get();

    if (!state.semester || !state.semester.initialized) {
      window.location.href = (window as any).route ? (window as any).route("/onboarding") : "/onboarding";
    }

    let selectedDateStr = "";
    const gridCellsContainer = document.getElementById("calendar-grid-cells");
    const monthYearLabel = document.getElementById("month-year-label");
    const prevMonthBtn = document.getElementById("btn-prev-month");
    const nextMonthBtn = document.getElementById("btn-next-month");

    const modal = document.getElementById("calendar-modal");
    const modalDateLabel = document.getElementById("modal-date-label");
    const modalLecturesContainer = document.getElementById("modal-lectures-container");
    const modalLecturesSection = document.getElementById("modal-lectures-section");
    const closeModalBtn = document.getElementById("btn-close-modal");
    const holidayToggleBtn = document.getElementById("btn-modal-holiday-toggle");
    const holidayToggleSlider = document.getElementById("holiday-toggle-slider");

    let currentDate = new Date();

    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, "0");
    const day = String(today.getDate()).padStart(2, "0");
    const todayStr = `${year}-${month}-${day}`;

    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    const formatDateStr = (date: Date): string => {
      const y = date.getFullYear();
      const m = String(date.getMonth() + 1).padStart(2, "0");
      const d = String(date.getDate()).padStart(2, "0");
      return `${y}-${m}-${d}`;
    };

    const getDateStatusDetails = (date: Date) => {
      const dateStr = formatDateStr(date);
      const weekday = date.getDay();

      const startStr = state.semester?.startDate || "";
      if (dateStr < startStr) {
        return { type: "OUTSIDE", label: "", borderClass: "border-transparent", colorClass: "bg-transparent text-muted-soft/20" };
      }

      if (weekday === 0) {
        return { type: "SUNDAY", label: "Sun", borderClass: "border-hairline", colorClass: "bg-surface-soft/40 text-muted-soft/30 italic text-[7.5px] font-bold" };
      }

      // Check Holiday
      const holiday = state.holidays.find((h: any) => h.date === dateStr);
      if (holiday) {
        return { type: "HOLIDAY", label: "Holiday", borderClass: "border-blue-200 dark:border-blue-900/30", colorClass: "bg-blue-500/10 dark:bg-blue-500/15 text-blue-500 font-extrabold" };
      }

      // Expected slots
      const expectedSlots = state.timetable.filter((t: any) => t.dayOfWeek === weekday);
      if (expectedSlots.length === 0) {
        return { type: "FREE", label: "Free", borderClass: "border-hairline-soft", colorClass: "bg-surface-soft/30 text-muted-soft/30 text-[7px]" };
      }

      // Dynamic check-in evaluation
      const dayLogs = [];
      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const ist = new Date(utc + (3600000 * 5.5));
      const isPast5PM = ist.getHours() >= 17;

      expectedSlots.forEach((slot: any) => {
        const log = state.attendanceLogs.find(
          (l: any) => l.date === dateStr && l.slotId === slot.id
        );
        if (log) {
          dayLogs.push(log.status);
        } else {
          // Unmarked expected slots: auto-present theory only
          const subject = state.subjects.find((s: any) => s.id === slot.subjectId);
          const isTheory = subject?.type === "THEORY";
          if (isTheory) {
            if (dateStr < todayStr) {
              dayLogs.push("PRESENT"); // auto-present past
            } else if (dateStr === todayStr && isPast5PM) {
              dayLogs.push("PRESENT"); // auto-present today after 5PM IST
            }
          }
        }
      });

      // Include manual one-offs
      state.attendanceLogs.forEach((log: any) => {
        if (log.date === dateStr && (log.slotId === null || !expectedSlots.some(s => s.id === log.slotId))) {
          dayLogs.push(log.status);
        }
      });

      if (dayLogs.length === 0) {
        return { type: "UNMARKED", label: "Unmarked", borderClass: "border-dashed border-muted-soft/40", colorClass: "text-muted-soft bg-canvas" };
      }

      const presents = dayLogs.filter((s) => s === "PRESENT").length;
      const absents = dayLogs.filter((s) => s === "ABSENT").length;
      const cancelled = dayLogs.filter((s) => s === "CANCELLED").length;
      const totalConducted = dayLogs.length - cancelled;

      if (cancelled === dayLogs.length) {
        return { type: "CANCELLED", label: "Cancelled", borderClass: "border-zinc-300 dark:border-zinc-700/50", colorClass: "bg-zinc-500/10 text-zinc-500 font-bold" };
      }

      if (presents === totalConducted) {
        return { type: "PRESENT", label: "Present", borderClass: "border-emerald-200 dark:border-emerald-900/30", colorClass: "bg-emerald-500/10 text-emerald-500 font-extrabold" };
      }

      if (absents === totalConducted) {
        return { type: "ABSENT", label: "Absent", borderClass: "border-rose-200 dark:border-rose-900/30", colorClass: "bg-rose-500/10 text-rose-500 font-extrabold" };
      }

      return { type: "PARTIAL", label: "Partial", borderClass: "border-amber-200 dark:border-amber-900/30", colorClass: "bg-amber-500/10 text-amber-500 font-extrabold" };
    };

    const renderCalendar = () => {
      state = store.get();
      if (!gridCellsContainer || !monthYearLabel) return;

      const year = currentDate.getFullYear();
      const month = currentDate.getMonth();

      monthYearLabel.textContent = `${monthNames[month]} ${year}`;
      gridCellsContainer.innerHTML = "";

      const firstDayIndex = new Date(year, month, 1).getDay();
      // If 1st is Sunday (0), we render the Mon-Sat grid, starting with Monday (no blanks).
      // If 1st is Monday (1), 0 blanks. If Tue (2), 1 blank. If Wed (3), 2 blanks, etc.
      const blankCount = firstDayIndex === 0 ? 0 : firstDayIndex - 1;

      for (let i = 0; i < blankCount; i++) {
        const blank = document.createElement("div");
        blank.className = "bg-surface-soft/20 h-16 border-b border-r border-hairline-soft";
        gridCellsContainer.appendChild(blank);
      }

      const numDays = new Date(year, month + 1, 0).getDate();
      for (let i = 1; i <= numDays; i++) {
        const date = new Date(year, month, i);
        if (date.getDay() === 0) continue; // Skip Sunday cells entirely to fix Mon-Sat grid shifts!
        
        const details = getDateStatusDetails(date);
        
        const cell = document.createElement("div");
        cell.className = `h-16 bg-canvas p-2 flex flex-col justify-between select-none relative transition-all duration-300 border-b border-r border-hairline-soft ${
          details.type !== "OUTSIDE" && details.type !== "SUNDAY"
            ? "cursor-pointer hover:bg-surface-soft/40 active:scale-95"
            : ""
        }`;
        
        cell.innerHTML = `
          <span class="text-[10px] font-bold ${details.type === "OUTSIDE" ? "text-muted-soft/25" : "text-ink"}">
            ${i}
          </span>
          ${details.label ? `
            <div class="text-[7px] leading-3 py-0.5 px-1 border rounded-md font-bold text-center select-none truncate ${details.borderClass} ${details.colorClass} uppercase tracking-wider">
              ${details.label}
            </div>
          ` : ""}
        `;

        if (details.type !== "OUTSIDE" && details.type !== "SUNDAY") {
          cell.addEventListener("click", () => {
            selectedDateStr = formatDateStr(date);
            openModal();
          });
        }

        gridCellsContainer.appendChild(cell);
      }
    };

    const openModal = () => {
      if (!modal || !modalDateLabel) return;
      modalDateLabel.textContent = selectedDateStr;
      
      updateHolidayToggleUI();
      renderModalLectures();
      modal.classList.remove("hidden");
    };

    const updateHolidayToggleUI = () => {
      if (!holidayToggleBtn || !holidayToggleSlider) return;
      const isHoliday = state.holidays.some((h: any) => h.date === selectedDateStr);
      
      if (isHoliday) {
        holidayToggleBtn.classList.remove("bg-hairline");
        holidayToggleBtn.classList.add("bg-primary");
        holidayToggleSlider.classList.remove("translate-x-0");
        holidayToggleSlider.classList.add("translate-x-4");
        modalLecturesSection?.classList.add("hidden");
      } else {
        holidayToggleBtn.classList.remove("bg-primary");
        holidayToggleBtn.classList.add("bg-hairline");
        holidayToggleSlider.classList.remove("translate-x-4");
        holidayToggleSlider.classList.add("translate-x-0");
        modalLecturesSection?.classList.remove("hidden");
      }
    };

    const renderModalLectures = () => {
      if (!modalLecturesContainer) return;
      modalLecturesContainer.innerHTML = "";

      const dateObj = new Date(selectedDateStr);
      const weekday = dateObj.getDay();
      if (weekday === 0) return;

      const daySlots = state.timetable
        .filter((t: any) => t.dayOfWeek === weekday)
        .sort((a: any, b: any) => a.sequenceOrder - b.sequenceOrder);

      if (daySlots.length === 0) {
        modalLecturesContainer.innerHTML = `<p class="text-[9px] text-muted-soft py-4 text-center uppercase tracking-wider font-bold">No lectures scheduled today.</p>`;
        return;
      }

      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const ist = new Date(utc + (3600000 * 5.5));
      const isPast5PM = ist.getHours() >= 17;

      daySlots.forEach((slot: any, idx: number) => {
        const subject = state.subjects.find((s: any) => s.id === slot.subjectId);
        
        // Read evaluated status for unmarked support
        const log = state.attendanceLogs.find(
          (l: any) => l.date === selectedDateStr && l.slotId === slot.id
        );
        let currentStatus = null;
        if (log) {
          currentStatus = log.status;
        } else {
          const isTheory = subject?.type === "THEORY";
          if (isTheory) {
            if (selectedDateStr < todayStr) {
              currentStatus = "PRESENT";
            } else if (selectedDateStr === todayStr && isPast5PM) {
              currentStatus = "PRESENT";
            }
          }
        }

        const row = document.createElement("div");
        row.className = "flex items-center justify-between p-2.5 border border-hairline rounded-xl bg-surface-soft/20 hover:border-muted-soft transition-all duration-300";
        row.innerHTML = `
          <div class="min-w-0 flex-1 pr-2">
            <span class="font-bold text-xs text-ink truncate block">${subject ? subject.name : "Unknown"}</span>
            <span class="text-[8px] uppercase tracking-wider text-muted-soft font-bold">Lecture ${idx + 1}</span>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <button class="btn-modal-mark h-7 w-7 flex items-center justify-center border rounded-full cursor-pointer transition-all duration-200 ${
              currentStatus === "PRESENT"
                ? "bg-emerald-500 border-emerald-500 text-white shadow-md shadow-success-glow"
                : "border-hairline bg-canvas text-muted-text hover:text-emerald-500"
            }" data-slot-id="${slot.id}" data-subject-id="${slot.subjectId}" data-status="PRESENT">
              <svg class="h-3.5 w-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </button>
            <button class="btn-modal-mark h-7 w-7 flex items-center justify-center border rounded-full cursor-pointer transition-all duration-200 ${
              currentStatus === "ABSENT"
                ? "bg-rose-50 border-rose-500 text-rose-500"
                : "border-hairline bg-canvas text-muted-text hover:text-rose-500"
            }" data-slot-id="${slot.id}" data-subject-id="${slot.subjectId}" data-status="ABSENT">
              <svg class="h-3.5 w-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <button class="btn-modal-mark h-7 w-7 flex items-center justify-center border rounded-full text-[10px] font-extrabold select-none cursor-pointer transition-all duration-200 ${
              currentStatus === "CANCELLED"
                ? "bg-amber-500 border-amber-500 text-white"
                : "border-hairline bg-canvas text-muted-text hover:text-amber-500"
            }" data-slot-id="${slot.id}" data-subject-id="${slot.subjectId}" data-status="CANCELLED">
              C
            </button>
          </div>
        `;
        modalLecturesContainer.appendChild(row);
      });

      document.querySelectorAll(".btn-modal-mark").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const slotId = target.getAttribute("data-slot-id") || "";
          const subId = target.getAttribute("data-subject-id") || "";
          const status = target.getAttribute("data-status") as AttendanceStatus;

          const existingIdx = state.attendanceLogs.findIndex(
            (l: any) => l.date === selectedDateStr && l.slotId === slotId
          );

          if (existingIdx >= 0) {
            if (state.attendanceLogs[existingIdx].status === status) {
              state.attendanceLogs = state.attendanceLogs.filter((_, idx) => idx !== existingIdx);
            } else {
              state.attendanceLogs[existingIdx].status = status;
              state.attendanceLogs[existingIdx].updatedAt = new Date().toISOString();
            }
          } else {
            state.attendanceLogs.push({
              id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
              subjectId: subId,
              slotId,
              date: selectedDateStr,
              status,
              updatedAt: new Date().toISOString(),
            });
          }

          store.save(state);
          renderModalLectures();
        });
      });
    };

    holidayToggleBtn?.addEventListener("click", () => {
      const idx = state.holidays.findIndex((h: any) => h.date === selectedDateStr);
      if (idx >= 0) {
        state.holidays = state.holidays.filter((_, i) => i !== idx);
      } else {
        state.holidays.push({
          id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
          date: selectedDateStr,
          name: "Holiday Override",
        });
      }
      store.save(state);
      updateHolidayToggleUI();
      renderModalLectures();
    });

    // Calendar Modal Present All / Absent All listeners
    document.getElementById("btn-modal-present-all")?.addEventListener("click", () => {
      const dateObj = new Date(selectedDateStr);
      const weekday = dateObj.getDay();
      if (weekday === 0) return;

      const daySlots = state.timetable.filter((t: any) => t.dayOfWeek === weekday);
      daySlots.forEach((slot: any) => {
        const existingIdx = state.attendanceLogs.findIndex(
          (l: any) => l.date === selectedDateStr && l.slotId === slot.id
        );
        if (existingIdx >= 0) {
          state.attendanceLogs[existingIdx].status = "PRESENT";
        } else {
          state.attendanceLogs.push({
            id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
            subjectId: slot.subjectId,
            slotId: slot.id,
            date: selectedDateStr,
            status: "PRESENT",
            updatedAt: new Date().toISOString(),
          });
        }
      });
      store.save(state);
      renderModalLectures();
    });

    document.getElementById("btn-modal-absent-all")?.addEventListener("click", () => {
      const dateObj = new Date(selectedDateStr);
      const weekday = dateObj.getDay();
      if (weekday === 0) return;

      const daySlots = state.timetable.filter((t: any) => t.dayOfWeek === weekday);
      daySlots.forEach((slot: any) => {
        const existingIdx = state.attendanceLogs.findIndex(
          (l: any) => l.date === selectedDateStr && l.slotId === slot.id
        );
        if (existingIdx >= 0) {
          state.attendanceLogs[existingIdx].status = "ABSENT";
        } else {
          state.attendanceLogs.push({
            id: crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 9),
            subjectId: slot.subjectId,
            slotId: slot.id,
            date: selectedDateStr,
            status: "ABSENT",
            updatedAt: new Date().toISOString(),
          });
        }
      });
      store.save(state);
      renderModalLectures();
    });

    closeModalBtn?.addEventListener("click", () => {
      modal?.classList.add("hidden");
      renderCalendar();
    });

    prevMonthBtn?.addEventListener("click", () => {
      currentDate.setMonth(currentDate.getMonth() - 1);
      renderCalendar();
    });

    nextMonthBtn?.addEventListener("click", () => {
      currentDate.setMonth(currentDate.getMonth() + 1);
      renderCalendar();
    });

    renderCalendar();
  </script>
</Layout>
